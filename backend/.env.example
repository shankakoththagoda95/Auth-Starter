DATABASE_URL=postgresql+asyncpg://auth_user:local-development-password@localhost:5432/auth_starter
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
SESSION_SECRET=replace-this-with-a-long-random-value-before-deploying
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Auth Starter <no-reply@auth-starter.local>
VERIFICATION_TOKEN_LIFETIME_HOURS=24
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
SESSION_COOKIE_NAME=auth_session
SESSION_LIFETIME_DAYS=7
# Keep false only for local HTTP development. Production must use HTTPS and set this to true.
COOKIE_SECURE=false
